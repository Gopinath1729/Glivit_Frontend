{
  "expo": {
    "name": "GLIVT",
    "slug": "glivt",
    "description": "Secure live GPS vehicle tracking, trip history, geofences, speed alerts, reports, and device health.",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "glivt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vehiclemoment.tracker",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is shown on the tracking map so you can see where you are relative to the fleet."
      }
    },
    "android": {
      "package": "com.vehiclemoment.tracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B161E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 145,
          "resizeMode": "contain",
          "backgroundColor": "#0B161E",
          "dark": {
            "backgroundColor": "#0B161E"
          }
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Glivt to show your position relative to tracked vehicles and geofences."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
