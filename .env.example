# The app talks ONLY to Spring Boot. Backend base URL by target:
#   Android emulator:  http://10.0.2.2:8085
#   USB (adb reverse tcp:8085 tcp:8085):  http://127.0.0.1:8085
#   Physical device / Wi-Fi:  http://<your-lan-ip>:8085
#   Production:  https://api.example.com  (HTTPS)
EXPO_PUBLIC_GEOAPIFY_API_KEY=a98fdc454ced4527895f07642f15ff83
# Android emulator: http://10.0.2.2:8085
# Physical device: use this computer's LAN IP, e.g. http://192.168.0.3:8085
# Never use localhost/127.0.0.1 from a mobile app; that points at the device.
EXPO_PUBLIC_BACKEND_BASE_URL=http://192.168.1.5:8085
# Android production builds use this for react-native-maps / Google Maps.
GOOGLE_MAPS_API_KEY=
# Demo mode enables local-only demo UX and canned data. DEV-ONLY: it is
# force-disabled in production/release builds (gated behind __DEV__), so it can
# never leak into a shipped app even if left true. Super Admin Demo quick-login
# calls POST /api/auth/demo/super-admin and also requires the backend to run
# with APP_DEMO_LOGIN_ENABLED=true.
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_ALLOW_CLEARTEXT_HTTP=true
EXPO_PUBLIC_RAZORPAY_ENABLED=false
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID_ANDROID=
EXPO_PUBLIC_FIREBASE_APP_ID_IOS=
