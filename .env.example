# The app talks ONLY to Spring Boot. Backend base URL by target:
#   Android emulator:  http://10.0.2.2:8085
#   USB (adb reverse tcp:8085 tcp:8085):  http://127.0.0.1:8085
#   Physical device / Wi-Fi:  http://<your-lan-ip>:8085
#   Production:  https://api.example.com  (HTTPS)
# Required by fleet, live-tracking, playback, and geofence maps on every
# platform. This is a PUBLIC, Map-Tiles-only key. It must be different from the
# backend GEOAPIFY_API_KEY used for Map Matching API requests.
EXPO_PUBLIC_GEOAPIFY_TILES_API_KEY=
# Existing installations may temporarily retain the legacy public tile-key name
# EXPO_PUBLIC_GEOAPIFY_API_KEY. Rename it to the variable above when convenient.
# Road map matching is a BACKEND concern and is configured there
# (MAP_MATCHING_PROVIDER / GEOAPIFY_API_KEY). The app never calls a
# routing service itself: it draws the matched geometry the API returns. Doing
# it here meant one rate-limited request per device per fix, which is why live
# updates used to arrive minutes late or not at all.
#
# Verbose raw -> validated -> matched GPS tracing in the console. Development
# only; it is compiled out of release builds.
EXPO_PUBLIC_GPS_DIAGNOSTICS=false
# Android emulator: http://10.0.2.2:8085
# Physical device: use this computer's LAN IP, e.g. http://192.168.0.3:8085
# Never use localhost/127.0.0.1 from a mobile app; that points at the device.
EXPO_PUBLIC_BACKEND_BASE_URL=https://degrading-squiggly-although.ngrok-free.dev
# Optional legacy native-map key. Core fleet/live/playback maps do not use it;
# they render Geoapify through MapLibre consistently on Android, iOS, and web.
GOOGLE_MAPS_API_KEY=
# The app always uses the configured backend. There is no canned/demo auth path.
# Android releases intentionally reject clear-text HTTP. Use an HTTPS backend
# in every build (an HTTPS tunnel is fine for local device testing).
